TEXT(APPLIQUE_NAME, "Appliqué", "Applikation", "Aplikacja")
TEXT(USE_TOP, "Use this top", "Top übernehmen", "Zastosuj wierzch")
TEXT(ON_CLOTH, "On plain cloth", "Auf Unistoff", "Na jednolitym tle")
TEXT(ON_QUILT, "Add to my quilt", "Auf meinen Quilt", "Na mojej kołdrze")
TEXT(LIFT_APPLIQUE, "Remove appliqué", "Applikation entfernen", "Usuń aplikację")
TEXT(PICK_TOP, "Edit background", "Hintergrund bearbeiten", "Edytuj tło")
TEXT(PICK_ALL, "Edit all layers", "Alle Lagen bearbeiten", "Edytuj wszystkie warstwy")
TEXT(WHOLE_GUIDE, "Choose a pieced top or layer an appliqué.", "Ein Top wählen oder eine Applikation auflegen.", "Wybierz wierzch lub dodaj na niego aplikację.")
TEXT(WHOLE_KEYS, "Arrows Design   Enter Apply   B Plain cloth", "Pfeile Muster   Enter Anwenden   B Unistoff", "Strzałki Wzór   Enter Zastosuj   B Jednolite tło")
TEXT(WHOLE_DIMENSIONS, "%s finished", "Fertigmaß %s", "Wymiar po zszyciu %s")
TEXT(WHOLE_TOTAL, "Cut %d fabric pieces", "%d Stoffteile zuschneiden", "Elementy do wycięcia: %d")
TEXT(TRACE_HELP, "The PDF includes full-size tracing pages.", "Das PDF enthält Schablonen in Originalgröße.", "PDF zawiera szablony w skali 1:1.")
TEXT(FOUNDATION_CUT, "Trace the solid stitching lines. The dashed cut lines include %s on each edge.", "Durchgezogene Nahtlinien abpausen. Die gestrichelten Schnittlinien enthalten %s Nahtzugabe.", "Odrysuj ciągłe linie szycia. Przerywane linie cięcia zawierają zapas %s przy każdej krawędzi.")
TEXT(APPLIQUE_CUT, "Raw-edge appliqué: cut on the outline, with no seam allowance. Layer pieces in the order listed.", "Offenkantige Applikation: auf der Kontur ohne Nahtzugabe schneiden. Teile in der angegebenen Reihenfolge auflegen.", "Aplikacja z surowym brzegiem: tnij po obrysie bez zapasu na szew. Nakładaj elementy w podanej kolejności.")
TEXT(WEAVE_HELP, "Lay the long ribbons across the top. Weave the second set over and under, alternating each row. The map shows the upper ribbon at each crossing.", "Lange Bänder auslegen. Die zweite Gruppe abwechselnd darüber und darunter weben, in jeder Reihe versetzt. Die Skizze zeigt das oben liegende Band.", "Ułóż długie wstęgi. Drugi zestaw przeplataj nad i pod nimi, zmieniając kolejność w każdym rzędzie. Na mapie widać wierzchnią wstęgę.")
TEXT(PIECE_LIST, "Piece / fabric / cut size", "Teil / Stoff / Zuschnittmaß", "Element / tkanina / wymiar cięcia")
TEXT(TRACE_TILE, "%s / tile %d,%d of %d × %d", "%s / Blatt %d,%d von %d × %d", "%s / arkusz %d,%d z %d × %d")
TEXT(PRINT_SCALE, "Print at 100%. Trim to the frame and join matching edges.", "Bei 100 % drucken. Am Rahmen beschneiden und passende Kanten verbinden.", "Drukuj w skali 100%. Przytnij do ramki i połącz pasujące krawędzie.")
TEXT(SCALE_CHECK, "Scale check", "Kontrollmaß", "Sprawdź skalę")
TEXT(BLOCK_LAYER, "Block layout", "Blockanordnung", "Układ bloków")
TEXT(TRACE_RAW, "Solid: appliqué cut line     Dotted: finished quilt edge", "Durchgezogen: Schnittkante der Applikation     Gepunktet: fertige Quiltkante", "Linia ciągła: krawędź cięcia aplikacji     Kropki: brzeg gotowej kołdry")
TEXT(TRACE_PIECED, "Solid: stitching line     Dashed: cutting line", "Durchgezogen: Nahtlinie     Gestrichelt: Schnittlinie", "Linia ciągła: linia szycia     Przerywana: linia cięcia")
TEXT(SHOOT_PIECE, "Branch", "Rankenzweig", "Odgałęzienie")
TEXT(EYE_PIECE, "Koi eye", "Koi-Auge", "Oko karpia")
TEXT(RESTORE_TOP, "Restore blocks", "Blöcke zurückholen", "Przywróć bloki")
TEXT(WHOLE_TOP_KEYS, "Arrows Design   Enter Apply", "Pfeile Muster   Enter Anwenden", "Strzałki Wzór   Enter Zastosuj")
TEXT(CANVAS_WHOLE, "Arrows browse. Enter applies. B places appliqué on plain cloth. X removes appliqué. G restores the block layout.", "Pfeile blättern. Enter übernimmt. B setzt die Applikation auf Unistoff. X entfernt die Applikation. G stellt die Blöcke wieder her.", "Strzałki wybierają wzór. Enter stosuje. B nakłada aplikację na jednolite tło. X usuwa aplikację. G przywraca bloki.")
