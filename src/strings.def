TEXT(GRID_PATCHES, "%d x %d patches   /   %s finished", "%d × %d Teile   /   Fertigmaß %s", "Układ %d × %d elementów   /   Po zszyciu %s")
TEXT(ROW_MAP, "Row map", "Reihenplan", "Układ rzędów")
TEXT(MAP_USAGE, "Take the sheet for cut templates.", "Schablonen stehen im Zuschnittplan.", "Szablony znajdziesz w planie cięcia.")
TEXT(ROW_USAGE, "Sew one row at a time, top to bottom.", "Reihen nacheinander von oben nähen.", "Zszywaj rzędy od góry do dołu.")
TEXT(SHEET_FABRIC, "FABRIC", "STOFF", "TKANINA")
TEXT(SHEET_PIECES, "PIECES", "TEILE", "ELEMENTY")
TEXT(SEAM_SHORT, "Seam allowance %s on every edge", "Nahtzugabe %s an jeder Kante", "Zapas na szew %s przy każdej krawędzi")
TEXT(DOWNLOAD_TEXT, "Download text sheet", "Text herunterladen", "Pobierz tekst")
TEXT(COPY_TEXT, "Copy text sheet", "Text kopieren", "Kopiuj tekst")
