/* Key, English, German, Polish. Keep format arguments in the same order. */
TEXT(DESIGN_NAME, "Design wall", "Entwurfswand", "Plansza")
TEXT(SHEET_NAME, "Cutting sheet", "Zuschnittplan", "Plan cięcia")
TEXT(PATTERNS_NAME, "Patterns", "Muster", "Wzory")
TEXT(COLORS_NAME, "Colors", "Farben", "Kolory")
TEXT(UNDO_NAME, "Undo", "Rückgängig", "Cofnij")
TEXT(REDO_NAME, "Redo", "Wiederholen", "Ponów")
TEXT(LANGUAGE_NAME, "Language", "Sprache", "Język")
TEXT(LANGUAGE_KEYS, "1  English   2  Deutsch   3  Polski   Esc  Close", "1  English   2  Deutsch   3  Polski   Esc  Schließen", "1  English   2  Deutsch   3  Polski   Esc  Zamknij")
TEXT(CANVAS_KEYS, "Patchwork. Press L for language, U for units, P for patterns and F for colors. Press Tab for the cutting sheet. Use arrows to move, brackets to pick a piece and Space to place it.", "Patchwork. L für Sprache, U für Maßeinheit, P für Muster und F für Farben. Tab öffnet den Zuschnittplan. Pfeile zum Bewegen, Klammern zur Teilewahl und Leertaste zum Einsetzen.", "Patchwork. L zmienia język, U jednostkę, P otwiera wzory, a F kolory. Tab otwiera plan cięcia. Strzałki przesuwają kursor, nawiasy wybierają element, a spacja go wstawia.")
TEXT(CANVAS_LANGUAGE, "Language. 1 English, 2 Deutsch, 3 Polski. Escape closes the menu.", "Sprache. 1 English, 2 Deutsch, 3 Polski. Escape schließt das Menü.", "Język. 1 English, 2 Deutsch, 3 Polski. Escape zamyka menu.")
TEXT(CANVAS_PATTERNS, "Pattern library. 1 to 3 filter, arrows browse, brackets change the setting, Enter fills the quilt and B places one block.", "Musterbibliothek. 1 bis 3 filtern, Pfeile blättern, Klammern ändern die Anordnung, Enter füllt den Quilt und B setzt einen Block ein.", "Biblioteka wzorów. 1 do 3 filtruje, strzałki przewijają, nawiasy zmieniają układ, Enter wypełnia kołdrę, a B wstawia pojedynczy blok.")
TEXT(CANVAS_COLORS, "Colors. Left and right browse palette pages. Press 1 to 5 to edit a fabric color.", "Farben. Links und rechts blättern durch die Paletten. 1 bis 5 bearbeiten eine Stofffarbe.", "Kolory. Lewa i prawa strzałka przewijają palety. 1 do 5 otwiera edycję koloru tkaniny.")
TEXT(CANVAS_EDIT, "Enter applies the value. Escape cancels.", "Enter übernimmt den Wert. Escape bricht ab.", "Enter stosuje wartość. Escape anuluje.")
TEXT(SAVED, "Saved on this device", "Auf diesem Gerät gespeichert", "Zapisano na tym urządzeniu")
TEXT(EDITS_SAVE, "Edits save on this device", "Änderungen werden hier gespeichert", "Zmiany są zapisywane na tym urządzeniu")
TEXT(SAVE_FAILED, "Saving failed. Press S to retry.", "Speichern fehlgeschlagen. Erneut versuchen mit S.", "Zapis nie powiódł się. Naciśnij S, aby ponowić.")
TEXT(PROTECTED_PLAN, "Could not read the saved plan. Original preserved.", "Der gespeicherte Entwurf ist unlesbar. Das Original bleibt erhalten.", "Nie można odczytać zapisanego projektu. Oryginał zachowano.")
TEXT(SETTINGS_FAILED, "Could not save preferences", "Einstellungen konnten nicht gespeichert werden", "Nie udało się zapisać ustawień")
TEXT(EXPORT_FAILED, "Could not export the cutting sheet", "Der Zuschnittplan konnte nicht exportiert werden", "Nie udało się wyeksportować planu cięcia")
TEXT(SHEET_DOWNLOADED, "Cutting sheet downloaded", "Zuschnittplan heruntergeladen", "Pobrano plan cięcia")
TEXT(SHEET_COPIED, "Cutting sheet copied", "Zuschnittplan kopiert", "Skopiowano plan cięcia")
TEXT(PDF_EXPORTED, "PDF exported", "PDF exportiert", "Wyeksportowano PDF")
TEXT(OPEN_FAILED, "Could not open the design wall: %s", "Die Entwurfswand konnte nicht geöffnet werden: %s", "Nie udało się otworzyć planszy: %s")
TEXT(USAGE, "Usage: patchwork [--project PATH]", "Aufruf: patchwork [--project PFAD]", "Użycie: patchwork [--project ŚCIEŻKA]")
TEXT(FABRIC_BASKET, "Fabric basket", "Stoffkorb", "Koszyk tkanin")
TEXT(QUILT_SIZE, "Quilt size", "Quiltgröße", "Rozmiar kołdry")
TEXT(COLUMNS_NAME, "Columns", "Spalten", "Kolumny")
TEXT(ROWS_NAME, "Rows", "Reihen", "Rzędy")
TEXT(SQUARE_NAME, "Square", "Quadrat", "Kwadrat")
TEXT(SEAMS_NAME, "Seams", "Nähte", "Szwy")
TEXT(CHOOSE_FABRIC, "Choose a fabric, then click a piece to place it.", "Stoff wählen und auf ein Teil klicken.", "Wybierz tkaninę i kliknij element.")
TEXT(MIXED_NAME, "Sampler quilt", "Sampler-Quilt", "Kołdra z różnych bloków")
TEXT(PLACE_HINT, "Click a block to place %s.", "Für %s einen Block anklicken.", "Kliknij blok, aby wstawić wzór %s.")
TEXT(ROTATE_NAME, "Rotate", "Drehen", "Obróć")
TEXT(FINISH_NAME, "Finish placing", "Beenden", "Zakończ")
TEXT(TOP_SIZE, "Finished top   %s", "Fertigmaß   %s", "Wymiar po zszyciu   %s")
