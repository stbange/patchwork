TEXT(TRADITIONAL_NAME, "Traditional", "Traditionell", "Tradycyjne")
TEXT(MODERN_NAME, "Modern", "Modern", "Nowoczesne")
TEXT(LIBRARY_NAME, "Pattern library", "Musterbibliothek", "Biblioteka wzorów")
TEXT(DESIGN_COUNT, "%d designs / %d settings each", "%d Muster / je %d Anordnungen", "%d wzorów / po %d układów")
TEXT(PREVIOUS, "Previous", "Zurück", "Wstecz")
TEXT(NEXT, "Next", "Weiter", "Dalej")
TEXT(PATTERN_UNDO, "Undo restores your previous layout.", "Rückgängig stellt den alten Entwurf wieder her.", "Cofnij przywraca poprzedni układ.")
TEXT(SETTING_NAME, "Quilt setting", "Anordnung", "Układ bloków")
TEXT(APPLY_PATTERN, "Fill quilt", "Quilt füllen", "Wypełnij kołdrę")
TEXT(PLACE_BLOCK, "Place block", "Block einsetzen", "Wstaw blok")
TEXT(DESIGN_KEYS, "1-5 Fabric   Arrows Move   [ ] Piece   Space Place", "1-5 Stoff   Pfeile Bewegen   [ ] Teil   Leertaste Einsetzen", "1-5 Tkanina   Strzałki Ruch   [ ] Element   Spacja Wstaw")
TEXT(SHEET_KEYS, "Tab Design wall   Enter Text   D PDF", "Tab Entwurfswand   Enter Text   D PDF", "Tab Plansza   Enter Tekst   D PDF")
TEXT(LIBRARY_KEYS, "Arrows Design   [ ] Setting   Enter Fill   B Place", "Pfeile Muster   [ ] Anordnung   Enter Füllen   B Block", "Strzałki Wzór   [ ] Układ   Enter Wypełnij   B Blok")
TEXT(COLOR_KEYS, "Arrows Browse   1-5 Edit fabric", "Pfeile Blättern   1-5 Stoff bearbeiten", "Strzałki Przewiń   1-5 Edytuj tkaninę")
TEXT(COLOR_LIBRARY, "Fabric colors", "Stofffarben", "Kolory tkanin")
TEXT(PALETTES_NAME, "Named palettes", "Farbpaletten", "Palety kolorów")
TEXT(PALETTES_HELP, "Choose a palette to change all five fabrics.", "Eine Palette ändert alle fünf Stofffarben.", "Paleta zmienia kolory wszystkich pięciu tkanin.")
TEXT(CUSTOM_HELP, "Choose a fabric to edit its color.", "Stoff wählen, um seine Farbe zu ändern.", "Wybierz tkaninę do zmiany koloru.")
TEXT(EDIT_COLOR, "Edit fabric %c", "Stoff %c bearbeiten", "Edytuj tkaninę %c")
TEXT(CUSTOM_COLOR, "Hex color", "Hex-Farbe", "Kolor szesnastkowy")
TEXT(HEX_HELP, "Enter six hex digits, such as 4C6171.", "Sechs Hex-Ziffern eingeben, etwa 4C6171.", "Wpisz sześć cyfr szesnastkowych, np. 4C6171.")
TEXT(EDIT_SIZE, "Finished block edge", "Fertige Blockkante", "Bok gotowego bloku")
TEXT(SIZE_HELP, "Enter a size from %s to %s.", "Ein Maß zwischen %s und %s eingeben.", "Wpisz wymiar od %s do %s.")
TEXT(APPLY_NAME, "Apply", "Übernehmen", "Zastosuj")
TEXT(CANCEL_NAME, "Cancel", "Abbrechen", "Anuluj")
TEXT(INVALID_VALUE, "Check the value and try again.", "Wert prüfen und erneut versuchen.", "Sprawdź wartość i spróbuj ponownie.")
TEXT(TEXT_FILENAME, "patchwork-cutting-sheet.txt", "patchwork-zuschnittplan.txt", "patchwork-plan-ciecia.txt")
TEXT(PDF_FILENAME, "patchwork-cutting-sheet.pdf", "patchwork-zuschnittplan.pdf", "patchwork-plan-ciecia.pdf")
TEXT(PDF_FILETYPE, "PDF document", "PDF-Dokument", "Dokument PDF")
TEXT(SHEET_HEADER, "PATCHWORK / CUTTING SHEET", "PATCHWORK / ZUSCHNITTPLAN", "PATCHWORK / PLAN CIĘCIA")
TEXT(FINISHED_LINE, "Finished top: %s (%s)", "Fertigmaß: %s (%s)", "Wymiar po zszyciu: %s (%s)")
TEXT(CUT_SQUARES, "Cut %d squares at %s", "%d Quadrate zuschneiden, je %s", "Kwadraty do wycięcia: %d   Wymiar: %s")
TEXT(CUT_PIECES, "Cut %d pieces for %d blocks", "%d Teile für %d Blöcke zuschneiden", "Elementy do wycięcia: %d   Bloki: %d")
TEXT(BLOCK_EDGE, "Finished base block edge: %s", "Fertige Kante des Grundblocks: %s", "Bok podstawowego bloku po zszyciu: %s")
TEXT(SEAM_SQUARE, "Includes a %s seam on all four edges.", "Enthält %s Nahtzugabe an allen vier Kanten.", "Uwzględnia zapas na szew %s przy czterech krawędziach.")
TEXT(SEAM_PATCH, "Includes a %s seam allowance on every piece edge.", "Enthält %s Nahtzugabe an jeder Kante.", "Uwzględnia zapas na szew %s przy każdej krawędzi.")
TEXT(TRIANGLE_NAME, "Triangle", "Dreieck", "Trójkąt")
TEXT(HEXAGON_NAME, "Hexagon", "Sechseck", "Sześciokąt")
TEXT(OCTAGON_NAME, "Octagon", "Achteck", "Ośmiokąt")
TEXT(RECTANGLE_NAME, "Rectangle", "Rechteck", "Prostokąt")
TEXT(DIAMOND_NAME, "Diamond", "Raute", "Romb")
TEXT(QUADRILATERAL_NAME, "Quadrilateral", "Viereck", "Czworokąt")
TEXT(TEMPLATE_LINE, "Template %d: %s, %s", "Schablone %d: %s, %s", "Szablon %d: %s, %s")
TEXT(CUT_VERB, "Cut", "Zuschnitt", "Wytnij")
TEXT(CUT_POINTS, "Cut points:", "Zuschnittpunkte:", "Punkty cięcia:")
TEXT(CUT_GUIDE, "CUT TEMPLATES\nDimensions give the width and height of the box around each template.\nMeasure each point from the upper-left of the box. Join the points in order and close the outline.",
     "ZUSCHNITTSCHABLONEN\nDie Maße geben Breite und Höhe des umschließenden Rechtecks an.\nPunkte von links oben messen. Die Punkte der Reihe nach verbinden und die Kontur schließen.",
     "SZABLONY DO CIĘCIA\nWymiary to szerokość i wysokość prostokąta obejmującego szablon.\nOdmierz punkty od lewego górnego rogu. Połącz je po kolei i zamknij obrys.")
TEXT(LAYOUT_HEAD, "LAYOUT (top row first)", "ANORDNUNG (oberste Reihe zuerst)", "UKŁAD (od górnego rzędu)")
TEXT(LAYOUT_GUIDE, "Read the blocks left to right. R0, R90, R180 and R270 turn a block clockwise.\nA2 means fabric A, template 2. A dash marks a plain block.",
     "Blöcke von links nach rechts lesen. R0, R90, R180 und R270 geben die Drehung im Uhrzeigersinn an.\nA2 steht für Stoff A und Schablone 2. Ein Strich kennzeichnet einen einteiligen Block.",
     "Czytaj bloki od lewej do prawej. R0, R90, R180 i R270 oznaczają obrót zgodnie z ruchem wskazówek zegara.\nA2 to tkanina A i szablon 2. Kreska oznacza blok z jednego kawałka.")
TEXT(ROW_LABEL, "Row %d", "Reihe %d", "Rząd %d")
TEXT(BLOCK_GUIDE, "PIECES IN LAYOUT ORDER\nMatch G in the row map to the guides below. Measure from the upper-left of the finished block.\nThe points already account for the block's turn and the seam layout.",
     "TEILE IN DER REIHENFOLGE DES PLANS\nG im Reihenplan verweist auf die Blockskizzen unten. Von links oben am fertigen Block messen.\nDie Punkte berücksichtigen Drehung und Nahtverlauf.",
     "ELEMENTY W KOLEJNOŚCI PLANU\nG w układzie rzędów wskazuje rozpiski poniżej. Mierz od lewego górnego rogu bloku.\nPunkty uwzględniają obrót bloku i układ szwów.")
TEXT(PIECE_LABEL, "Piece %d:", "Teil %d:", "Element %d:")
TEXT(PLAIN_BLOCK, "Plain block", "Einteiliger Block", "Blok jednolity")
TEXT(ORIGINAL_PALETTE, "Original colors", "Originalfarben", "Kolory początkowe")
